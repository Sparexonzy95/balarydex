# ========================================================
# Balary Deployment Configuration - LitVM (LiteForge Testnet)
# ========================================================

# LitVM LiteForge Testnet RPC (Chain ID 4441)
RPC_URL=https://liteforge.rpc.caldera.xyz/http
CHAIN_ID=4441

# Deployer Private Key (64 hex chars with or without 0x prefix)
PRIVATE_KEY=

# Deployer / Admin Wallet Address (Receives initial supply & owns PoolManager)
# Leave blank to automatically use the address derived from your PRIVATE_KEY:
ADDRESS_TO_MINT_TO=

# (Optional) Explorer API for contract verification
EXPLORER_URL=https://liteforge.explorer.caldera.xyz
